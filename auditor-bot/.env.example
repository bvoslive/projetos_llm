# Backend do juiz: "heuristic" (offline, sem custo, para demo/CI) ou "llm"
FISCAL_JUDGE_BACKEND=heuristic

# Modelo barato usado em todas as rubricas (formato "provedor:modelo" do LangChain)
FISCAL_JUDGE_MODEL=anthropic:claude-haiku-5-5
# Modelo mais forte, usado só para reavaliar casos incertos (opcional)
FISCAL_ESCALATION_MODEL=anthropic:claude-sonnet-5-5

# Chaves do provedor escolhido
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Confiança mínima para aceitar um achado sem revisão
FISCAL_REVIEW_THRESHOLD=0.75

# Sal do HMAC usado na pseudonimização de PII. TROQUE em produção.
FISCAL_PII_SALT=troque-este-valor

# API / webhooks
FISCAL_DB_PATH=fiscal.db
FISCAL_KB_PATH=data/loja_pitanga/kb.yaml
FISCAL_WEBHOOK_VERIFY_TOKEN=troque-este-token
